{
  "name": "@otb/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@otb/core": "workspace:*",
    "@otb/ui": "workspace:*",
    "@otb/api": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tauri-apps/cli": "^2.0.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "executor": "nx:run-script",
        "options": {
          "script": "dev",
          "parallel": true
        }
      },
      "build": {
        "enabled": false
      }
    }
  }
}
