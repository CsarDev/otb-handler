{
  "name": "@otb/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@otb/api": "workspace:*",
    "@otb/auth": "workspace:*",
    "@otb/core": "workspace:*",
    "@otb/db": "workspace:*",
    "@otb/excel": "workspace:*",
    "@otb/logger": "workspace:*",
    "@otb/pdf": "workspace:*",
    "@otb/ui": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "executor": "nx:run-script",
        "options": {
          "script": "dev",
          "parallel": true
        }
      }
    }
  }
}