{
  "name": "@otb/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@otb/core": "workspace:*",
    "@otb/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-router": "^1.170.0",
    "zustand": "^5.0.0",
    "react-hook-form": "^7.53.0",
    "zod": "^4.0.0",
    "@hookform/resolvers": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vitest": "^2.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "executor": "nx:run-script",
        "options": {
          "script": "dev",
          "parallel": true
        }
      },
      "build": {
        "executor": "nx:run-script",
        "options": {
          "script": "build",
          "parallel": true
        }
      }
    }
  }
}
