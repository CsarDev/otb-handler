{
  "name": "otb-handler",
  "private": true,
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many --targets=dev --parallel",
    "build": "nx run-many --targets=build --parallel",
    "test": "nx run-many --targets=test --parallel",
    "lint": "nx run-many --targets=lint --parallel",
    "typecheck": "nx run-many --targets=typecheck --parallel",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "update-deps": "pnpm update -r --latest",
    "clean": "rm -rf node_modules dist .nx .cache packages/**/dist apps/**/dist",
    "setup-ci": "pnpm install --frozen-lockfile",
    "graph": "nx graph --file=graph.json && echo 'Graph saved to graph.json'"
  },
  "devDependencies": {
    "@nx/eslint": "^20.0.0",
    "@nx/js": "^20.0.0",
    "@nx/react": "^20.0.0",
    "@nx/vite": "^20.0.0",
    "@nx/workspace": "^20.0.0",
    "nx": "^20.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
