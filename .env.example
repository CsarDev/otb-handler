# ============================================
# OTB Handler — Variables de Entorno
# ============================================
# Copiar a .env y editar segun corresponda

# Puerto del servidor API
PORT=3000

# URL de la base de datos
# SQLite (dev):  DB_URL=./otb.db
# PostgreSQL:    DB_URL=postgres://otb:password@localhost:5432/otb
DB_URL=./otb.db

# JWT Secret — CAMBIAR en produccion
JWT_SECRET=change-me-to-a-random-secret

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Entorno
NODE_ENV=development